# Python
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.mypy_cache/
.ruff_cache/

# venv
.venv/
venv/

# build artifacts (수정 금지 산출물)
build/
dist/
out/

# secrets / env (HF_TOKEN 등 — 커밋 금지)
.env
.env.*

# local Claude settings (team-shared rules는 커밋, local은 제외)
.claude/settings.local.json
.claude/scheduled_tasks.lock

# 테스트 미디어 픽스처(바이너리 — 커밋 안 함; 스파이크/라이브 e2e가 로컬에서 참조).
# 재현엔 한국어 오디오 클립이 repo 루트에 필요(handoff 참고).
*.mp4
*.wav
*.m4a
*.webm

# 비전 그라운딩 탐색(.dev/vision/ — 진입점 README.md, 메모 vision-nonverbal-instability).
# venv·모델 가중치 = 무거움 / frames = kor.mp4에서 추출한 인물 스틸(클립과 같은 비커밋 정책).
# 스크립트(.py)·결과(.json)·문서(.md)는 커밋한다.
/.dev/.venv-vision/
/.dev/vision/models/
/.dev/vision/frames/
